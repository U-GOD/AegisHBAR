# AegisHBAR Global Environment Configuration Example

# ---------------------------------------------------------
# Backend Services (.env for the /backend directory)
# ---------------------------------------------------------

# Hedera Testnet Credentials (Agent Identity)
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=your_ecdsa_private_key_here
HEDERA_NETWORK=testnet

# Smart Contracts (HTS & HSCS)
AUDIT_ESCROW_ADDRESS=0xFc5322eE88f892DbB271e002C7cfe49795dE684b
AUDIT_REGISTRY_ADDRESS=0x15D03b790103CB070035F192c1022Cc2ECE25BD6
AUDIT_CERTIFICATE_TOKEN_ID=0.0.xxxxx

# Hedera Consensus Service
HEDERA_HCS_TOPIC_ID=0.0.xxxxx

# AI Provider Keys
OPENAI_API_KEY=sk-proj-...

# IPFS Pinning (Pinata)
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

# Facilitator URL for x402
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# ---------------------------------------------------------
# Frontend (.env.local for the /frontend directory)
# ---------------------------------------------------------

NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_HEDERA_NETWORK=testnet
